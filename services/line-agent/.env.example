# Enter secrets through the hosting provider's private environment settings.
# Do not send keys, tokens, passwords, or service-account JSON in chat.
PORT=3000
DATA_DIR=/data
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Optional known LINE group ID. A group invitation URL is not a group ID.
LINE_GROUP_ID=
# At least 24 random characters. Used once: /pair <code> in the intended group.
PAIRING_CODE=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Each question normally makes two AI calls. This is a count limit, not a dollar cap.
MAX_AI_CALLS_PER_DAY=100
# JSON service-account credentials, stored as a private runtime variable.
GOOGLE_SERVICE_ACCOUNT_JSON=
AGENT_SPREADSHEET_ID=
COW_SOURCE_SPREADSHEET_ID=
MILK_TEST_SOURCE_SPREADSHEET_ID=
DAILY_SOURCE_FILE_ID=
# Enable only after the private variables and Google sharing are configured.
BOT_ENABLED=false
